# PNA_MANAGED_COPYPARTY_V095
[global]
  i: 127.0.0.1
  p: 3923
  j: 1
  name: PNA Drive
  http-only
  no-crt
  usernames
  no-robots
  no-logues
  no-readme
  no-thumb
  no-mtag-ff
  rproxy: 1
  xff-hdr: x-forwarded-for
  xff-src: 127.0.0.0/8, ::1/128
  ah-alg: scrypt
  ah-salt: @PASSWORD_SALT@

[accounts]
  @ACCOUNT_USERNAME@: @ACCOUNT_HASH@

[/]
  /srv/proxy-node-assistant/drive-data
  accs:
    rwdma: @ACCOUNT_USERNAME@
  flags:
    e2ds
    hist: /var/lib/proxy-node-assistant/copyparty/volume
    u2sz: 1,64,64
    vmaxb: @QUOTA_GIB@g
    vmaxn: 100k
    df: @MIN_FREE_BYTES@b
    grid
    xvol
    xdev
    nohtml
    no_logues
    no_readme
    dthumb
    d2t
