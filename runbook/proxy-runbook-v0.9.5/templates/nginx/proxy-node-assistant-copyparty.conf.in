# PNA_MANAGED_COPYPARTY_NGINX_V095
server {
    listen @LISTEN_ADDRESS@:@ORIGIN_PORT@ ssl http2;
    server_name @DRIVE_HOSTNAME@;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/@DRIVE_HOSTNAME@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DRIVE_HOSTNAME@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:pna_drive_ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 80m;
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:3923;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Cache-Control "private, no-store" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
}
