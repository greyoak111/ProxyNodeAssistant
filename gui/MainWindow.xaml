									<PasswordBox x:Name="DriveAdminNewPassword" Height="40" Background="#071116" Foreground="#E5F0F3" BorderBrush="#28505D" Padding="10,8" />
									<TextBlock Text="再次输入新密码" Foreground="#83A2B1" FontSize="11" Margin="0,12,0,6" />
									<PasswordBox x:Name="DriveAdminConfirmPassword" Height="40" Background="#071116" Foreground="#E5F0F3" BorderBrush="#28505D" Padding="10,8" />
									<Button x:Name="DriveCreateAdminButton" Content="创建并生成恢复包" Style="{StaticResource PrimaryButtonStyle}" Height="42" Margin="0,15,0,0" />
								</StackPanel>
							</Border>
							<Border Background="#050D12" BorderBrush="#173742" BorderThickness="1" Padding="26,22" Margin="0,14,0,0">
								<StackPanel>
									<TextBlock x:Name="DriveSafetyTitle" Text="安全模型" FontSize="17" FontWeight="SemiBold" />
									<TextBlock x:Name="DriveSafetyBody" Text="• 文件只经 SSH 隧道传输，VPS 公网不监听网盘端口。&#x0a;• 普通账号是节点空间账号，可在该节点所有受信设备使用。&#x0a;• 文件保存在 VPS 磁盘，并非端到端加密；VPS root/宿主方可能读取。&#x0a;• 未配置异机备份时，全部数据仍可能随 VPS 丢失。" Foreground="#8FA6B3" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />
									<Border Background="#071A20" BorderBrush="#155366" BorderThickness="1" Padding="11,10" Margin="0,17,0,0">
										<TextBlock Text="高危操作（安装、拆除、恢复基线、凭据轮换）仍需进入高级控制台，并可按本机 admin 门禁设置拦截。" Foreground="#68E5F5" FontSize="10.5" TextWrapping="Wrap" />
									</Border>
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</Grid>

				<Grid x:Name="DriveWorkspaceView" Grid.Row="1" Visibility="Collapsed">
					<Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<Border Background="#040B0F" BorderBrush="#18313A" BorderThickness="0,0,1,0" Padding="18,20">
						<StackPanel>
							<TextBlock Text="// ACTIVE SPACE" Foreground="#36DDF4" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Bold" />
							<TextBlock x:Name="DriveSessionAccount" Text="account" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="Bold" Margin="0,10,0,0" />
							<TextBlock x:Name="DriveSessionNode" Text="node" Foreground="#6F8794" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" Margin="0,4,0,0" TextWrapping="Wrap" />
							<Button x:Name="DriveFilesNavButton" Content="[01]  文件" Style="{StaticResource NavButtonStyle}" Tag="active" Margin="0,24,0,0" />
							<Button x:Name="DriveTransfersNavButton" Content="[02]  传输任务" Style="{StaticResource NavButtonStyle}" />
							<Button x:Name="DriveAccountNavButton" Content="[03]  账号与安全" Style="{StaticResource NavButtonStyle}" />
							<Button x:Name="DriveMountNavButton" Content="[04]  挂载与节点" Style="{StaticResource NavButtonStyle}" />
							<Button x:Name="DriveAdvancedNavButton" Content="[05]  高级运维" Style="{StaticResource NavButtonStyle}" />
							<Button x:Name="DriveLogoutButton" Content="退出当前空间" Style="{StaticResource SecondaryButtonStyle}" Height="39" Margin="0,25,0,0" />
						</StackPanel>
					</Border>
					<Grid x:Name="DriveFilesPanel" Grid.Column="1" Margin="22,18,22,16">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock x:Name="DriveFilesTitle" Text="私人文件" FontSize="22" FontWeight="SemiBold" />
								<TextBlock x:Name="DriveCurrentPath" Text="/" Foreground="#54CBE1" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,5,0,0" />
							</StackPanel>
							<Button x:Name="DriveWorkspaceRefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
						</Grid>
						<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,11">
							<Button x:Name="DriveUpButton" Content="← 上一级" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
							<Button x:Name="DriveNewFolderButton" Content="新建目录" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
							<Button x:Name="DriveUploadButton" Content="上传" Style="{StaticResource PrimaryButtonStyle}" Height="36" />
							<Button x:Name="DriveDownloadButton" Content="下载" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
							<Button x:Name="DriveRenameButton" Content="重命名" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
							<Button x:Name="DriveDeleteButton" Content="移入回收区" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
						</StackPanel>
						<DataGrid x:Name="DriveFileGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#03080B" Foreground="#D7E7EB" BorderBrush="#19343E" RowBackground="#050D12" AlternatingRowBackground="#061116" HorizontalGridLinesBrush="#132A32">
							<DataGrid.Columns>
								<DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
								<DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120" />
								<DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="120" />
								<DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="185" />
							</DataGrid.Columns>
						</DataGrid>
						<Border Grid.Row="3" Background="#061116" BorderBrush="#18333C" BorderThickness="1" Padding="11,8" Margin="0,10,0,0">
							<TextBlock x:Name="DriveWorkspaceStatus" Text="安全隧道已建立。未配置异机备份：全部数据可能丢失。" Foreground="#D3AA55" FontSize="10.5" TextWrapping="Wrap" />
						</Border>
					</Grid>
					<Grid x:Name="DriveMountPanel" Grid.Column="1" Margin="22,18,22,16" Visibility="Collapsed">
						<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
						<Grid>
							<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock x:Name="DriveMountTitle" Text="挂载与节点" FontSize="22" FontWeight="SemiBold" />
								<TextBlock x:Name="DriveMountSubtitle" Text="固定校验 rclone + WinFsp · 每台 VPS 独立盘符" Foreground="#54CBE1" FontFamily="Cascadia Mono, Consolas" FontSize="10" Margin="0,5,0,0" />
							</StackPanel>
							<Button x:Name="DriveMountRefreshButton" Grid.Column="1" Content="刷新状态" Style="{StaticResource SecondaryButtonStyle}" Height="36" />
						</Grid>
						<Grid Grid.Row="1" Margin="0,17,0,13">
							<Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
							<Border Background="#061116" BorderBrush="#1A3B46" BorderThickness="1" Padding="16,14" Margin="0,0,7,0">
								<StackPanel>
									<TextBlock x:Name="DriveMountDependencyTitle" Text="01 // 本机依赖" FontFamily="Cascadia Mono, Consolas" Foreground="#36DDF4" FontWeight="Bold" />
									<TextBlock x:Name="DriveMountDependencyStatus" Text="正在校验固定版本…" Foreground="#91A8B5" TextWrapping="Wrap" Margin="0,9,0,0" />
									<Button x:Name="DriveMountInstallButton" Content="安装 / 验证 WinFsp 与 rclone" Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,13,0,0" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Background="#061116" BorderBrush="#1A3B46" BorderThickness="1" Padding="16,14" Margin="7,0,0,0">
								<StackPanel>
									<TextBlock x:Name="DriveMountModeTitle" Text="02 // 新建挂载" FontFamily="Cascadia Mono, Consolas" Foreground="#36DDF4" FontWeight="Bold" />
									<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
										<TextBlock x:Name="DriveMountLetterLabel" Text="盘符" Foreground="#8FA6B3" VerticalAlignment="Center" Margin="0,0,8,0" />
										<ComboBox x:Name="DriveMountLetter" Style="{StaticResource DarkComboBoxStyle}" Width="78" Height="31" />
									</StackPanel>
									<RadioButton x:Name="DriveMountReadOnly" Content="只读浏览盘（推荐）" IsChecked="True" Foreground="#D7E7EB" Margin="0,11,0,0" />
									<RadioButton x:Name="DriveMountReadWrite" Content="小文件读写盘（有缓存风险）" Foreground="#F2C66D" Margin="0,7,0,0" />
									<Button x:Name="DriveMountStartButton" Content="挂载当前已登录节点" Style="{StaticResource PrimaryButtonStyle}" Height="38" Margin="0,12,0,0" />
								</StackPanel>
							</Border>
						</Grid>
						<DataGrid x:Name="DriveMountGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#03080B" Foreground="#D7E7EB" BorderBrush="#19343E" RowBackground="#050D12" AlternatingRowBackground="#061116" HorizontalGridLinesBrush="#132A32">
							<DataGrid.Columns>
								<DataGridTextColumn Header="盘符" Binding="{Binding Letter}" Width="90" />
								<DataGridTextColumn Header="节点" Binding="{Binding Node}" Width="*" />
								<DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="160" />
								<DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="180" />
							</DataGrid.Columns>
						</DataGrid>
						<Border Grid.Row="3" Background="#061116" BorderBrush="#18333C" BorderThickness="1" Padding="11,9" Margin="0,10,0,0">
							<Grid>
								<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
								<TextBlock x:Name="DriveMountStatus" Text="默认只读。大文件请使用传输队列，不要从资源管理器长时间写入。" Foreground="#D3AA55" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center" />
								<Button x:Name="DriveMountOpenButton" Grid.Column="1" Content="打开盘符" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="10,0,0,0" />
								<Button x:Name="DriveUnmountButton" Grid.Column="2" Content="安全卸载所选" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="8,0,0,0" />
							</Grid>
						</Border>
					</Grid>
				</Grid>

				<Border Grid.Row="2" Background="#040A0E" BorderBrush="#1A3440" BorderThickness="0,1,0,0">
					<Grid Margin="24,0"><TextBlock x:Name="DriveFooter" Text="TNA 0.9.5 · 零遥测 · 网盘仅监听 VPS 127.0.0.1" Foreground="#56707C" FontFamily="Cascadia Mono, Consolas" FontSize="9" VerticalAlignment="Center" /></Grid>
				</Border>
			</Grid>
		</Border>

        <Grid x:Name="AskPassOverlay" Grid.ColumnSpan="2" Background="#D0000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Background="#050C10" BorderBrush="#1A9AB1" BorderThickness="1" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="48" Height="48" Background="#071A21" BorderBrush="#155366" BorderThickness="1" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#36DDF4" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AskPassTitle" Text="输入 VPS 登录密码" FontSize="21" FontWeight="SemiBold" Margin="0,17,0,0" />
                    <TextBlock x:Name="AskPassPrompt" Text="密码只通过本机私有命名管道交给 OpenSSH。" Foreground="#A9B6CA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <PasswordBox x:Name="AskPassPassword" Height="43" Background="#0B1322" Foreground="White" BorderBrush="#3B4E73" BorderThickness="1" Padding="12,9" FontSize="14" Margin="0,18,0,0" />
                    <TextBlock x:Name="AskPassPrivacy" Text="不会写入命令行、日志、剪贴板或磁盘。" Foreground="#6F819D" FontSize="11" Margin="2,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="AskPassCancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                        <Button x:Name="AskPassSubmitButton" Content="交给 OpenSSH" Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="126" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
