<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="RootWindow"
        Title="ProxyNodeAssistant v1.0.0"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#030609" Foreground="#DCE8ED"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#627580" />
        <SolidColorBrush x:Key="SoftText" Color="#9AAAB2" />
        <SolidColorBrush x:Key="Accent" Color="#12CBE8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#09232B" />

        <Style x:Key="VerticalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#29414B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Width="8" Background="{TemplateBinding Background}" BorderBrush="#3A5662" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#0E7183" />
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#1DE2FF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#13CBE7" />
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#8DF3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HorizontalScrollThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Height" Value="8" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Background" Value="#29414B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody" Height="8" Background="{TemplateBinding Background}" BorderBrush="#3A5662" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#0E7183" />
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#1DE2FF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#13CBE7" />
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#8DF3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InvisibleScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="#05090C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="12" Background="{TemplateBinding Background}">
                            <Border Width="1" Background="#1B2B33" HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource InvisibleScrollPageButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VerticalScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource InvisibleScrollPageButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Height="12" Background="{TemplateBinding Background}">
                                    <Border Height="1" Background="#1B2B33" VerticalAlignment="Center" />
                                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" ViewportSize="{TemplateBinding ViewportSize}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource InvisibleScrollPageButtonStyle}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource HorizontalScrollThumbStyle}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource InvisibleScrollPageButtonStyle}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#AFC2CA" />
            <Setter Property="Background" Value="#071015" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBody" Background="{TemplateBinding Background}" BorderBrush="#172931" BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBody" Property="Background" Value="#09232B" />
                                <Setter Property="Foreground" Value="#57E7FA" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBody" Property="Background" Value="#0A2C35" />
                                <Setter Property="Foreground" Value="#71EDFC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4A5C65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keep every dropdown on the dark PNA canvas.  The stock WPF
             ComboBox template follows the Windows light theme and ignores
             the control Background for its popup, which made menu fields
             render as a white box with low-contrast text on some hosts. -->
        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#DDECF0" />
            <Setter Property="Background" Value="#071116" />
            <Setter Property="BorderBrush" Value="#28505D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropButton"
                                          OverridesDefaultStyle="True"
                                          FocusVisualStyle="{x:Null}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          IsEnabled="{TemplateBinding IsEnabled}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <!-- Do not let the host Windows theme supply its light
                                         ToggleButton chrome.  That stock template can
                                         override Background on hover/pressed and briefly
                                         flash a pale-blue/white field. -->
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="DropChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DropChrome" Property="Background" Value="#0A1D24" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#3A7F8C" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DropChrome" Property="Background" Value="#0D2B34" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#12CBE8" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="DropChrome" Property="Background" Value="#0A2028" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#12CBE8" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="DropChrome" Property="Background" Value="#0D2932" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#57E7FA" />
                                            </MultiTrigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True" />
                                                    <Condition Property="IsPressed" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="DropChrome" Property="Background" Value="#103640" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#71EDFC" />
                                            </MultiTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#57E7FA" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="DropChrome" Property="Background" Value="#080F14" />
                                                <Setter TargetName="DropChrome" Property="BorderBrush" Value="#1B2B33" />
                                                <Setter Property="Foreground" Value="#4A5C65" />
                                                <Setter Property="Opacity" Value="0.62" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter x:Name="SelectionContent"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Text="⌄"
                                               Foreground="#62D8E8"
                                               FontSize="13"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,2"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="DropPopup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="#071116"
                                        BorderBrush="#28505D"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, ElementName=DropButton}">
                                    <ScrollViewer MaxHeight="320" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropButton" Property="BorderBrush" Value="#12CBE8" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="DropButton" Property="BorderBrush" Value="#12CBE8" />
                                <Setter TargetName="DropButton" Property="Background" Value="#0A2028" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropButton" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#C9D2E3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0B161C" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#27434E" />
                                <Setter Property="Foreground" Value="#72EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#71848E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="NavRail" Width="2" Background="Transparent" HorizontalAlignment="Left" />
                            <Border x:Name="NavChrome" BorderBrush="Transparent" BorderThickness="0,0,1,0">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#07141A" />
                                <Setter Property="Foreground" Value="#B6C8D0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Background" Value="#08232B" />
                                <Setter TargetName="NavRail" Property="Background" Value="#12CBE8" />
                                <Setter Property="Foreground" Value="#5EEAFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="#07171D" />
            <Setter Property="Foreground" Value="#37DDF4" />
            <Setter Property="BorderBrush" Value="#11859A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Background" Value="#12CBE8" />
                                <Setter Property="Foreground" Value="#02080B" />
                                <Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#72EDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryChrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#080F13" />
            <Setter Property="Foreground" Value="#8EA2AC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryChrome" Background="{TemplateBinding Background}" BorderBrush="#263841" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryChrome" Property="Background" Value="#0A1B22" />
                                <Setter TargetName="SecondaryChrome" Property="BorderBrush" Value="#12CBE8" />
                                <Setter Property="Foreground" Value="#5EEAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionCardStyle" TargetType="Button">
            <Setter Property="Width" Value="282" />
            <Setter Property="Height" Value="150" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#071015" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1B2B33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="#091820" />
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="#12CBE8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#050A0E" BorderBrush="#1A2B33" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="104" />
                </Grid.RowDefinitions>

                <Grid Margin="18,12,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="BrandIcon" Width="30" Height="30" Stretch="Uniform" SnapsToDevicePixels="True" ToolTip="ProxyNodeAssistant" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                        <TextBlock Text="PNA // NODE OPS" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold" Foreground="#E3F6FA" />
                        <TextBlock Text="BUILD 1.0.0-R112  /  LOCAL" Foreground="#536771" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock x:Name="NavCaption" Text="// CONTROL MATRIX" Foreground="#4F646E" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" FontWeight="Bold" Margin="16,0,0,8" />
                    <Button x:Name="NavAll" Content="[00]  总览 / 全部功能" Style="{StaticResource NavButtonStyle}" Tag="active" />
                    <Button x:Name="NavInstall" Content="[01]  安装与升级" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="NavAccess" Content="[02]  面板与访问" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="NavMaintain" Content="[03]  维护与修复" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="NavSecurity" Content="[04]  安全与凭据" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="NavBackup" Content="[05]  备份与报告" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="NavLocal" Content="[06]  Windows 本地" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <Border Grid.Row="2" Margin="12,6,12,12" Background="#071116" BorderBrush="#1E333D" BorderThickness="1" Padding="12,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OpenSSHDot" Width="8" Height="8" Fill="#F3B85B" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="OpenSSHStatusText" Text="正在检查 OpenSSH…" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#C8D8DE" />
                        </StackPanel>
                        <TextBlock x:Name="PrivacyMiniText" Text="NO EMBEDDED SECRETS" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Foreground="#536771" Margin="16,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="#050A0E" BorderBrush="#1A2B33" BorderThickness="0,0,0,1">
                <Grid Margin="20,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TopTitle" Text="NODE INFRASTRUCTURE / OPERATIONS" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Bold" Foreground="#D8E8ED" />
                        <Border Background="#071920" BorderBrush="#155366" BorderThickness="1" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="LOCAL::FAIL_CLOSED" Foreground="#38DCF3" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LanguageButton" Content="EN" Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="13,0" Margin="0,0,8,0" />
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" />
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" />
                        <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel Margin="22,18,18,20">
                    <Border Background="#060D11" BorderBrush="#1C3039" BorderThickness="1" Padding="20,17">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="HeroEyebrow" Text="// PNA CONTROL FABRIC  /  SESSION:LOCAL" Foreground="#26D8EF" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Bold" />
                                <TextBlock x:Name="HeroTitle" Text="节点基础设施控制台" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0" />
                                <TextBlock x:Name="HeroSubtitle" Text="连接、输入、确认、进度和结果全部留在图形客户端内，不再弹出控制台。" Foreground="{StaticResource SoftText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="720" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="QuickInstall" Content="安装 / 升级" Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button x:Name="QuickDiagnose" Content="自动体检" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button x:Name="OpenTerminal" Content="完整图形菜单" Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Width="226" Margin="26,0,0,0" Background="#040A0D" BorderBrush="#1E333D" BorderThickness="1" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="RUNTIME STATUS" Foreground="#617685" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Bold" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="LOCAL CORE" Foreground="#9DB0BD" FontFamily="Cascadia Mono, Consolas" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="VERIFIED" Foreground="#34D399" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="SECRET PATH" Foreground="#9DB0BD" FontFamily="Cascadia Mono, Consolas" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="PIPE ONLY" Foreground="#67E8F9" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Bold" />
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="REMOTE POLICY" Foreground="#9DB0BD" FontFamily="Cascadia Mono, Consolas" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="FAIL-CLOSED" Foreground="#FBBF24" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="Bold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="#061116" BorderBrush="#18333C" BorderThickness="1" Padding="12,9" Margin="0,10,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#62D8C4" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SecurityNote" Text="远端项目会重新选择临时密码或节点长期 key；GUI 不保存 VPS 密码、域名、邮箱或密钥。" Foreground="#AAB8CA" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" Text="全部功能" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="SectionSubtitle" Text="SELECT OPERATION / EXECUTE FAIL-CLOSED" Foreground="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="9" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#061116" BorderBrush="#23404B" BorderThickness="1" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock x:Name="VisibleCount" Text="20 项" Foreground="#90A4B2" FontFamily="Cascadia Mono, Consolas" FontSize="10" />
                        </Border>
                    </Grid>

                    <WrapPanel x:Name="CardsPanel" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#050A0E" BorderBrush="#1A2B33" BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatus" Text="就绪 · 选择一项操作开始" Foreground="#72829B" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ProxyNodeAssistant 1.0.0" Foreground="#526078" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="OperationWorkspace" Grid.Column="1" Background="#030609" Visibility="Collapsed" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Border Background="#050A0E" BorderBrush="#1A2B33" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OperationBackButton" Content="&#xE72B;  返回总览" FontFamily="Segoe UI, Segoe MDL2 Assets" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0" Padding="14,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="OperationHeaderTitle" Text="操作" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="OperationHeaderSubtitle" Text="全部步骤均在当前窗口完成" Foreground="#7889A4" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OperationMinimizeButton" Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" />
                            <Button x:Name="OperationMaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" />
                            <Button x:Name="OperationCloseButton" Content="&#xE8BB;" Style="{StaticResource WindowButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="26,22,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="OperationLaunchPanel" Background="#060D11" BorderBrush="#1C3039" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="OperationSetupTitle" Text="准备操作" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OperationSetupDescription" Text="连接信息只用于本次操作，不会写回 EXE。" Foreground="#9EACC0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#071920" BorderBrush="#155366" BorderThickness="1" Padding="9,5" VerticalAlignment="Top">
                                    <TextBlock Text="SECURE WORKFLOW" Foreground="#5EE7F5" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Grid x:Name="RemoteConnectionForm" Grid.Row="1" Margin="0,18,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HistoryFieldLabel" Text="最近 VPS" Foreground="#8999B2" FontSize="11" VerticalAlignment="Center" Margin="2,0,12,0" />
                                    <ComboBox x:Name="ConnectionHistory" Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}" Height="36" Background="#071015" Foreground="#D4E4E9" BorderBrush="#29434E" Padding="9,5" FontSize="12" />
                                    <Button x:Name="HistoryUseButton" Grid.Column="2" Content="使用" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="8,0,0,0" Padding="14,0" />
                                    <Button x:Name="HistoryDeleteButton" Grid.Column="3" Content="删除此条" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="8,0,0,0" Padding="14,0" />
                                    <Button x:Name="HistoryClearButton" Grid.Column="4" Content="清空全部" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="8,0,0,0" Padding="14,0" />
                                </Grid>
                                <TextBlock x:Name="HistoryPrivacyNote" Grid.Row="1" Text="每次远端表单会自动载入最近目标，可修改；只保存地址、SSH 用户、端口与最后使用时间。密码每次输入，不保存。" Foreground="#657793" FontSize="10" Margin="2,6,0,0" />
                                <Grid Grid.Row="2" Margin="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.55*" />
                                        <ColumnDefinition Width="1.45*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock x:Name="HostFieldLabel" Text="VPS IP 或主机名" Foreground="#8999B2" FontSize="11" Margin="2,0,0,6" />
                                        <TextBox x:Name="ConnectionHostInput" Height="40" Background="#080F15" Foreground="#DCE7EC" BorderBrush="#2A3B46" BorderThickness="1" Padding="11,8" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock x:Name="UserFieldLabel" Text="SSH 用户名" Foreground="#8999B2" FontSize="11" Margin="2,0,0,6" />
                                        <TextBox x:Name="ConnectionUserInput" Text="root" Height="40" Background="#080F15" Foreground="#DCE7EC" BorderBrush="#2A3B46" BorderThickness="1" Padding="11,8" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock x:Name="PortFieldLabel" Text="端口" Foreground="#8999B2" FontSize="11" Margin="2,0,0,6" />
                                        <TextBox x:Name="ConnectionPortInput" Text="22" Height="40" Background="#080F15" Foreground="#DCE7EC" BorderBrush="#2A3B46" BorderThickness="1" Padding="11,8" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock x:Name="AuthFieldLabel" Text="本次 SSH 登录方式" Foreground="#8999B2" FontSize="11" Margin="2,0,0,6" />
                                        <ComboBox x:Name="ConnectionAuthMode" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" Height="40" Background="#071015" Foreground="#D4E4E9" BorderBrush="#29434E" Padding="9,6" FontSize="12">
                                            <ComboBoxItem Content="请选择登录方式…" Tag="" IsEnabled="False" />
                                            <ComboBoxItem Content="临时密码（操作后撤销一次性 key）" Tag="1" />
                                            <ComboBoxItem Content="节点长期 key（没有时询问是否绑定）" Tag="2" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OperationLaunchHint" Text="开始后，后续域名、邮箱、确认和选择会继续在下方图形输入区完成。" Foreground="#7789A5" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button x:Name="OperationStartButton" Grid.Column="1" Content="开始操作  →" Style="{StaticResource PrimaryButtonStyle}" Margin="18,0,0,0" MinWidth="132" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="OperationLogPanel" Grid.Row="1" Background="#03080B" BorderBrush="#1C3039" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="46" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="#061116" BorderBrush="#1C3039" BorderThickness="0,0,0,1">
                                <Grid Margin="15,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="OperationStatusDot" Width="8" Height="8" Fill="#22D3EE" Margin="0,0,9,0" />
                                        <TextBlock x:Name="OperationStatusText" Text="正在启动…" Foreground="#C7D2E4" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="OperationCopyLogButton" Content="复制日志" Style="{StaticResource SecondaryButtonStyle}" Height="31" Padding="11,0" Margin="0,0,7,0" />
                                        <Button x:Name="OperationClearLogButton" Content="清空显示" Style="{StaticResource SecondaryButtonStyle}" Height="31" Padding="11,0" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBox x:Name="OperationLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#05090D" Foreground="#B7C9D4" BorderThickness="0" Padding="16,14" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        </Grid>
                    </Border>

                    <Border x:Name="OperationInputPanel" Grid.Row="2" Background="#060D11" BorderBrush="#1C3039" BorderThickness="1" Padding="14,12" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OperationPromptText" Text="等待程序提示…" Foreground="#AEBBD0" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                    <Button x:Name="OperationYesButton" Content="是 / Y" Style="{StaticResource SecondaryButtonStyle}" Height="29" Padding="9,0" Margin="0,0,6,0" />
                                    <Button x:Name="OperationNoButton" Content="否 / N" Style="{StaticResource SecondaryButtonStyle}" Height="29" Padding="9,0" Margin="0,0,6,0" />
                                    <Button x:Name="OperationEnterButton" Content="直接回车" Style="{StaticResource SecondaryButtonStyle}" Height="29" Padding="9,0" Margin="0" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="OperationInput" Height="40" Background="#040A0D" Foreground="#E1F3F7" BorderBrush="#29434E" BorderThickness="1" Padding="11,8" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <PasswordBox x:Name="OperationSecretInput" Height="40" Background="#040A0D" Foreground="#E1F3F7" BorderBrush="#29434E" BorderThickness="1" Padding="11,8" FontFamily="Cascadia Mono, Consolas" FontSize="12" Visibility="Collapsed" />
                                </Grid>
                                <Button x:Name="OperationSendButton" Grid.Column="1" Content="提交" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="10,0,0,0" MinWidth="82" />
                                <Button x:Name="OperationStopButton" Grid.Column="2" Content="安全停止" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="8,0,0,0" MinWidth="88" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#050A0E" BorderBrush="#1A2B33" BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <TextBlock x:Name="OperationFooterText" Text="所有输入都在当前图形窗口内完成" Foreground="#72829B" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="AskPassOverlay" Grid.ColumnSpan="2" Background="#D0000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Background="#050C10" BorderBrush="#1A9AB1" BorderThickness="1" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="48" Height="48" Background="#071A21" BorderBrush="#155366" BorderThickness="1" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#36DDF4" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AskPassTitle" Text="输入 VPS 登录密码" FontSize="21" FontWeight="SemiBold" Margin="0,17,0,0" />
                    <TextBlock x:Name="AskPassPrompt" Text="密码只通过本机私有命名管道交给 OpenSSH。" Foreground="#A9B6CA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <PasswordBox x:Name="AskPassPassword" Height="43" Background="#0B1322" Foreground="White" BorderBrush="#3B4E73" BorderThickness="1" Padding="12,9" FontSize="14" Margin="0,18,0,0" />
                    <TextBlock x:Name="AskPassPrivacy" Text="不会写入命令行、日志、剪贴板或磁盘。" Foreground="#6F819D" FontSize="11" Margin="2,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="AskPassCancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" />
                        <Button x:Name="AskPassSubmitButton" Content="交给 OpenSSH" Style="{StaticResource PrimaryButtonStyle}" Margin="0" MinWidth="126" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
